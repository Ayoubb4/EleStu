{{!-- src/templates/service-booking-confirmation.hbs --}}
<!DOCTYPE html>
<html>
<head>
    <title>Confirmación de Reserva de Servicio</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { width: 80%; margin: 20px auto; border: 1px solid #ddd; padding: 20px; border-radius: 8px; }
        .header { background-color: #f4f4f4; padding: 10px; text-align: center; border-bottom: 1px solid #ddd; }
        .content { padding: 20px 0; }
        .footer { font-size: 0.9em; color: #666; text-align: center; border-top: 1px solid #eee; padding-top: 10px; margin-top: 20px; }
        h1 { color: #0056b3; }
        p { margin-bottom: 10px; }
        strong { color: #000; }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>¡Reserva de Servicio Confirmada!</h1>
    </div>
    <div class="content">
        <p>Hola,</p>
        <p>Tu reserva para el servicio **{{serviceTitle}}** ha sido confirmada.</p>
        <p>
            <strong>Fecha:</strong> {{date}}<br>
            <strong>Hora:</strong> {{time}}<br>
            <strong>Descripción de tu reserva:</strong> {{description}}<br>
            <strong>Precio:</strong> {{price}}€
        </p>
        <p>Para cualquier consulta sobre el servicio, puedes contactar directamente al proveedor:</p>
        <ul>
            <li>**Nombre del Proveedor:** {{ownerName}}</li>
            <li>**Email del Proveedor:** {{ownerEmail}}</li>
            <li>**Teléfono del Proveedor:** {{ownerPhoneNumber}}</li>
        </ul>
        <p>Gracias por tu reserva.</p>
    </div>
    <div class="footer">
        <p>&copy; {{currentYear}} EleStu. Todos los derechos reservados.</p>
    </div>
</div>
</body>
</html>
