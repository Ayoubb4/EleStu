{{!-- src/templates/service-booking-confirmation.hbs --}}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmación de Reserva de Servicio - EleStu</title>
    <style>
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            font-size: 16px;
            line-height: 1.6;
            color: #333;
            background-color: #f6f6f6;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 600px;
            margin: 30px auto;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            border: 1px solid #e9e9e9;
        }
        .header {
            background-color: #0038E1; /* Azul corporativo */
            padding: 20px;
            text-align: center;
            color: #ffffff;
        }
        .header img {
            max-width: 150px;
            height: auto;
            display: block;
            margin: 0 auto 10px;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 300;
        }
        .content {
            padding: 30px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }
        .content h2 {
            color: #1a202c;
            font-size: 22px;
            margin-top: 0;
            margin-bottom: 20px;
            border-bottom: 2px solid #f0f0f0;
            padding-bottom: 10px;
        }
        .content p {
            margin-bottom: 15px;
        }
        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }
        .details-table th, .details-table td {
            padding: 12px 15px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }
        .details-table th {
            background-color: #f9f9f9;
            color: #555;
            font-weight: bold;
            width: 35%;
        }
        .button-container {
            text-align: center;
            padding: 20px 30px;
        }
        .button {
            display: inline-block;
            background-color: #0052D4; /* Azul corporativo */
            color: #ffffff;
            padding: 12px 25px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
            font-size: 16px;
        }
        .footer {
            background-color: #f0f0f0;
            padding: 20px;
            text-align: center;
            font-size: 14px;
            color: #777;
        }
        .footer p {
            margin: 0;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        {{!-- El logo ahora usa una URL pública --}}
        <img src="https://imgur.com/a/sC7fPZq" alt="EleStu Logo">
        <h1>¡Reserva de Servicio Confirmada!</h1>
    </div>

    <div class="content">
        <p>Hola,</p>
        <p>Tu reserva para el servicio <strong>{{serviceTitle}}</strong> ha sido confirmada. Aquí tienes los detalles:</p>

        <table class="details-table">
            <tr>
                <th>Fecha:</th>
                <td>{{date}}</td>
            </tr>
            <tr>
                <th>Hora:</th>
                <td>{{time}}</td>
            </tr>
            <tr>
                <th>Descripción:</th>
                <td>{{description}}</td>
            </tr>
            <tr>
                <th>Precio Total:</th>
                <td>{{price}} €</td>
            </tr>
        </table>

        <h2>Datos del Proveedor</h2>
        <table class="details-table">
            <tr>
                <th>Nombre:</th>
                <td>{{ownerName}}</td>
            </tr>
            <tr>
                <th>Email:</th>
                <td>{{ownerEmail}}</td>
            </tr>
            <tr>
                <th>Teléfono:</th>
                <td>{{ownerPhoneNumber}}</td>
            </tr>
        </table>

        <p>¡Gracias por confiar en EleStu!</p>
    </div>

    <div class="button-container">
        <a href="https://elestu.onrender.com/reservations" class="button">Ver todas mis reservas</a>
    </div>

    <div class="footer">
        <p>&copy; {{currentYear}} EleStu. Todos los derechos reservados.</p>
    </div>
</div>
</body>
</html>